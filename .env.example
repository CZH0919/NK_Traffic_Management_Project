DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nk_traffic
DB_USER=nk_traffic_app
DB_PASSWORD=replace-with-database-password
# Alternatively set DB_PASSWORD_FILE to a private UTF-8 password file.
DB_TEST_NAME=test_nk_traffic
# Optional server-only JSON file: schema_version, provider, base_url, model, api_key.
# Keep the actual file outside the source submission package.
AI_CONFIG_FILE=
AI_ALLOWED_HOSTS=api.deepseek.com
AI_DAILY_CALL_LIMIT=20
AI_MAX_ATTEMPTS=3
AI_MAX_OUTPUT_TOKENS=2200
AI_REQUEST_TIMEOUT=60
AI_TEMPERATURE=0.2
